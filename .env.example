# Copy to .env and fill in.  Read by alphafraud/config.py via python-dotenv.
# .env is gitignored -- never commit real server details.

# --- Deploy target (used by deploy/deploy.sh) ---
# SSH destination for rsync, e.g. root@alphafraud.mdeller.com or an ~/.ssh/config alias.
DROPLET_SSH=root@mdeller.com
# Absolute path on the droplet where the code lives (provision.sh creates this).
DROPLET_PATH=/opt/alphafraud
# Optional explicit SSH key (else your default agent/key is used).
# SSH_KEY=~/.ssh/id_ed25519

# --- Web serving (used by nginx + gunicorn config) ---
# Public hostname certbot issues a cert for and nginx answers on.
SERVER_NAME=alphafraud.mdeller.com
# Address gunicorn binds to (nginx reverse-proxies TLS -> here).
BIND_ADDR=127.0.0.1:8000

# --- Pipeline knobs (optional; sensible defaults live in config.py) ---
# NOVELTY_IDENTITY_THRESHOLD=30      # % identity below which a sequence is "novel"
# RUN_LIMIT=                          # cap entities per run (blank = no cap)
